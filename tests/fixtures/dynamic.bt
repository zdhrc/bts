# dynamic blocks vary the shape of each generated trace; scoped vars are drawn
# once per scope, so the data stays coherent across it
vars {
    model = "gpt-4o-mini"
}

trace "support-sessions" {
    # drawn once per trace: the repeat and the summary below both see it
    vars {
        turns = range(1, 4)
    }

    repeat "turns" {
        count = var.turns

        task "turn" {
            input = "question ${repeat.index}"
            output = "answer ${repeat.index}"

            llm "Chat Completion" {
                # drawn once per iteration, so the token sum is exact
                vars {
                    prompt_toks = round(lognormal(600, 0.4))
                    completion_toks = round(lognormal(90, 0.7))
                }

                input = [
                    { role = "system", content = "You are a support agent." },
                    { role = "user", content = "question ${repeat.index}" },
                ]
                output = { role = "assistant", content = "answer ${repeat.index}" }
                metadata = { model = var.model, provider = "openai" }
                metrics = {
                    prompt_tokens = var.prompt_toks
                    completion_tokens = var.completion_toks
                    tokens = var.prompt_toks + var.completion_toks
                }
            }
        }
    }

    choice {
        tool "get_order_status" {
            input = { order_id = format("ord_{}", hex(8)) }
            output = { status = choice("shipped", "processing", "delayed") }
        }

        function "summarize_session" {
            input = { turns = var.turns }
            output = { summary = "customer asked about an order" }
        }
    }

    maybe {
        chance = 0.25

        task "escalation" {
            input = "customer requested a human agent"
            output = "escalated to tier 2"
        }
    }

    tags = ["support"]
}
