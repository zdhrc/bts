trace "multi-turn-conversation" {
    task "turn" {
        llm "gpt-4o-mini" {
            input = "Hey"
            output = "Hello!"

            metadata = {
                model = "gpt-4o-mini"
                provider = "openai"
                temperature = 0.2
                tool_choice = "auto"
            }

            metrics = {
                tokens = 4
            }
        }
    }

    task "turn" {
        llm "gpt-4o-mini" {
            input = "Goodbye"
            output = "Cya!"

            metadata = {
                model = "gpt-4o-mini"
                provider = "openai"
                temperature = 0.2
                tool_choice = "auto"
            }

            metrics = {
                tokens = 6
            }
        }
    }

    metadata = {
        external = true
    }
    tags = ["chat", "prod"]
}
