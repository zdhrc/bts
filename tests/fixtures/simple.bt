vars {
    assistant = "Eugene"
    meta = {
        model = "gpt-4o-mini"
        provider = "openai"
        temperature = 0.2
        tool_choice = "auto"
    }
}

trace "multi-turn-conversation" {
    task "turn" {
        llm "gpt-4o-mini" {
            input = "Hey"
            output = "Hello! I'm ${var.assistant}."

            metadata = var.meta

            metrics = {
                tokens = 4
            }
        }
    }

    task "turn" {
        llm "gpt-4o-mini" {
            input = "Goodbye"
            output = "Cya!"

            metadata = var.meta

            metrics = {
                tokens = 6
            }
        }
    }

    metadata = {
        external = true
    }
    tags = ["chat", "prod"]
}
