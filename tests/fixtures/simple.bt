# shared values, referenced as var.<name>
vars {
    system = """
        You are a concise personal finance assistant.
        Answer briefly.
        """
    meta = {
        model = "gpt-4o-mini"
        provider = "openai"
        temperature = 0.2
        tool_choice = "auto"
    }
}

trace "support-sessions" {
    # the root exchange replays the turns' own fields via block references
    input = [
        { role = "user", content = task.turn_0.input },
        { role = "user", content = task.turn_1.input },
    ]
    output = task.turn_1.output

    task "turn_0" {
        input = "How did NVDA do today?"
        output = "NVDA closed down 1.4% at $207.40."

        llm "Chat Completion" {
            input = [
                { role = "system", content = var.system },
                { role = "user", content = task.turn_0.input },
            ]
            output = { role = "assistant", content = task.turn_0.output }

            metadata = var.meta

            metrics = {
                prompt_tokens = 612
                completion_tokens = 24
                # sibling metric keys reference each other, so the sum is exact
                tokens = self.metrics.prompt_tokens + self.metrics.completion_tokens
                time_to_first_token = 0.4
            }
        }
    }

    task "turn_1" {
        input = "And over the last year?"
        output = "Up 20.4% over the past twelve months."

        llm "Chat Completion" {
            # later turns replay the earlier turns' fields instead of copying
            # the history by hand
            input = [
                { role = "system", content = var.system },
                { role = "user", content = task.turn_0.input },
                { role = "assistant", content = task.turn_0.output },
                { role = "user", content = task.turn_1.input },
            ]
            output = { role = "assistant", content = task.turn_1.output }

            metadata = var.meta

            metrics = {
                prompt_tokens = 648
                completion_tokens = 18
                tokens = self.metrics.prompt_tokens + self.metrics.completion_tokens
                time_to_first_token = 0.3
            }
        }
    }

    metadata = {
        entrypoint = "streamlit"
        conversation_id = uuid()
    }
    tags = ["chat", "prod"]
}
