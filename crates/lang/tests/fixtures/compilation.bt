# graph language showcase, parsed and lowered by the compilation tests
# language rules live in crates/lang/src/spec.rs
# built-in contracts live in the spec, domain kinds remain illustrative
# update the spec and affected examples together when a language rule changes

# standalone definitions do not acquire ownership from their use in a path
# variable lifetime and activation in this graph remain open
(settings:vars {evaluate: "lazy"}) {
    request_id: format("req_{}", hex(8)),
    max_attempts: 3,
    model: "intake-model",
    departments: [|"billing", "appointments", "records"|],
    department: choice("billing", "appointments", "records"),
};

# arrays, expressions, and eager binding configuration
(examples:vars {evaluate: "eager"}) {
    grouped: ${settings.max_attempts + 1} * 2,
    negative: -2,
    remainder: 5 % 2,
    eligible: true && !false || false,
    comparison: 2 <= 3 && 4 >= 3 && 2 != 3,
    conditional: settings.max_attempts > 1 ? "multiple" : "single",
    absent: null,
    first: settings.departments[0],
    selected: settings.departments[1:],
    combined: [|"intake", ...settings.departments|],
    copied: {...intake.input, request_id: settings.request_id},
    labels: [|for d in settings.departments: upper(d)|],
    indexed: {for i, d in settings.departments: d => i},
    source: (settings),
    filtered: [|for d in settings.departments: d if d != "billing"|],
    single: [|"appointments"|],
    empty: [||],
};

(intake:agent {label: "Hospital intake"}) {
    input: {message: "I need an appointment", patient_id: "p-123"},
    metadata: {request_id: settings.request_id},
    tags: [|"hospital", "intake"|],
}
    -[:entry]->(collect:llm {model: settings.model}) {
        input: intake.input,
        output: {patient_id: intake.input.patient_id},
        # self refers to this node in its properties and body expressions
        metrics: {
            prompt_tokens: tokens(self.input),
            completion_tokens: tokens(self.output),
            tokens: self.metrics.prompt_tokens + self.metrics.completion_tokens,
        },
    }
        -[:next]->(lookup:tool {name: "patient_lookup"}) {
            input: collect.output,
            output: {
                found: chance(0.8),
                needs_review: chance(0.1),
            },
        }
            =[:exclusive]=>[
                -[:next {when: source.output.found}]->(route:task) {
                    output: {department: settings.department},
                },
                -[:next {when: !source.output.found}]->("register-patient":tool {
                    name: "register_patient",
                }) {
                    input: collect.output,
                },
            ]
                ->(route)
                    =[:exclusive]=>[
                        -[:next {when: lookup.output.needs_review}]->(manual_review:tool {
                            name: "request_manual_review",
                        }) {
                            input: lookup.output,
                        },
                        -[:next {when: !lookup.output.needs_review}]->(prepare:task),
                    ]
                        ->(prepare)
                            =[patient_checks:parallel]=>[
                                -[coverage:next]->(check_coverage:tool {
                                    name: "check_coverage",
                                }) {
                                    input: {patient_id: collect.output.patient_id},
                                },
                                -[records:next]->(fetch_records:tool {
                                    name: "fetch_records",
                                }) {
                                    input: {patient_id: collect.output.patient_id},
                                },
                            ]
                                >[:accumulate {correlate: settings.request_id} [coverage], [records]]>>(finish);

# additional connections reuse existing definitions without redeclaring them
(manual_review)-[:next]->(finish);
("register-patient")-[:next]->(finish);

(finish:function) {
    output: {message: "Request ${settings.request_id} completed"},
};

# nested exclusive fork uses complementary guards to demonstrate coverage
# an exclusive fork may select no branch, no default is required
# the parallel inputs combine through a junction, not a converge edge
# entry and next remain candidate edge contracts

# conditional fork: every matching branch runs, no default is imposed here
# a separate optional path keeps this case distinct from intake's active chain
(optional_checks:task) {
    input: {needs_coverage: true, needs_records: false},
}
    =[selected_checks:conditional]=>[
        -[:next {when: optional_checks.input.needs_coverage}]->(coverage_note:function),
        -[:next {when: optional_checks.input.needs_records}]->(records_note:function),
    ];
# optional checks deliberately has no convergence dependency

# graph references, accessors, and value arrays
(graph_references:vars {evaluate: "lazy"}) {
    node: (lookup),
    edge: [coverage],
    fork: [patient_checks],
    qualified_edge: [patient_checks].[coverage],
    node_props: lookup.props.name,
    edge_props: [coverage].props,
    edge_source: [coverage].source,
    edge_target: [coverage].target,
    edge_scope: [coverage].scope,
    fork_props: [patient_checks].props,
    fork_source: [patient_checks].source,
    first_path: [patient_checks].paths[0],
    first_path_element: [patient_checks].paths[0][0],
    one_element_array: [|[coverage]|],
    edge_array: [|[coverage], [records]|],
    stored_paths: [patient_checks].paths,
    stored_target: self.stored_paths[0][0].target,
    selected_edge: [self.edge_array[0]],
    node_array: [|(lookup), (finish)|],
    selected_name: self.node_array[0].props.name,
};

# indentation attachment, edge lists, and anonymous targets
(layout_start:task)
    =[outer_layout:parallel]=>[
        -[outer_work:next]->(layout_work:task),
        -[outer_note:next, outer_data:feeds]->(layout_note:function),
    ]
        ->(layout_work)
            =[inner_layout:parallel]=>[
                -[inner_lookup:next]->(:tool {name: "lookup_visit"}),
                -[inner_check:next]->(layout_check:tool),
            ]
                ->([inner_lookup].target)-[:next]->(layout_result:function)
                >[:accumulate [inner_lookup], [inner_check]]>>(layout_combined:task)
        ->([outer_layout].[outer_note].target)-[:next]->(layout_finish:function);
# indenting the last selector under inner_layout would be invalid even qualified
# selectors and junctions at the same level are siblings, never a hidden chain

# one inline continuation is allowed, two inline siblings are not
(inline_start:task)=[:parallel]=>[-[:next]->(inline_work:task)] ->(inline_work)-[:next]->(inline_finish:task);

# string expressions, escapes, and declaration-aligned indentation
(prompt_examples:vars {evaluate: "lazy"}) {
    calculation: "Attempts: ${settings.max_attempts + 1}",
    function_call: "Request ${hex(8)}",
    conditional: "Mode: ${settings.max_attempts > 1 ? "multiple" : "single"}",
    escaped: "Write $${patient.name} in the template",
    price: "Price: $25",
    triple: """
        Steps:
          1. Identify the patient
          2. Confirm the appointment
    """,
    dedented: <<-PROMPT
        Steps:
          1. Identify the patient
          2. Confirm the appointment
    PROMPT,
    verbatim: <<RAW
        Preserve these leading spaces.
    RAW,
};
# triple produces Steps: followed by lines with two leading spaces
# plain heredoc keeps its content indentation, delimiter indentation is not content
# exact final-newline treatment for heredocs remains to be specified

# scope properties illustrate configuration for a future consumer
# context reads are explicit, propagation and occurrences remain consumer policies
(patient_summary:task)
    -[:next]->(fetch_patient:tool {name: "fetch_patient"}) {
        input: {patient_id: context.patient_id},
        output: {patient_id: context.patient_id},
    }
        -[:next]->(summarize:llm) {
            input: {
                patient: fetch_patient.output,
                purpose: context.purpose,
            },
        };

(intake_summary:agent {
    scope: {patient_id: "p-123", purpose: "prepare for an appointment"},
})
    -[:next]->(patient_summary);

(billing_summary:agent {
    scope: {patient_id: "p-123", purpose: "explain an invoice"},
})
    -[:next]->(patient_summary);

# independent incoming paths can combine through an explicit junction target
# the example scope property remains illustrative, not a finalized schema
(visit_intake:agent {
    scope: {patient: {id: "p-123"}},
})
    -[patient_details:next]->(capture_details:task);

(scheduling:agent {
    scope: {appointment: {visit_id: "v-101"}},
})
    -[appointment:next]->(confirm_appointment:task);

>[:accumulate {correlate: context.visit_id} [appointment], [patient_details]]>>(prepare_visit:task {accumulate: "each"}) {
    input: {
        patient: [patient_details].scope.patient,
        appointment: [appointment].scope.appointment,
    },
}
    -[:next]->(write_instructions:llm);

# an unlisted incoming edge remains independent of that junction
# prepare_visit's fields require combined scope, so this case needs a field policy
# a separate direct_visit agent could connect to prepare_visit through direct_arrival

# sibling junctions select overlapping sets of exact edges
(visit_checks:task)
    =[:parallel]=>[
        -[to_identity:next]->(identity_check:tool),
        -[to_insurance:next]->(insurance_check:tool),
        -[to_schedule:next]->(schedule_check:tool),
    ]
        >[:accumulate [to_identity], [to_insurance],]>>(eligibility:task)
        >[:accumulate [to_insurance], [to_schedule],]>>(booking:task);

# fork continuation selects a node before a cycle, without creating an edge
(recheck:task)
    =[:parallel]=>[
        -[:next]->(inspect:tool),
        -[:next]->(record_check:function),
    ]
        ->(inspect)
            ~[:repeat]~>(recheck);

# combined scopes remain separate, with no silent field merge
# junction kinds define combination behavior, properties configure it
# node accumulation properties remain illustrative consumer configuration
# correlation, occurrence selection, and policy composition remain open

# fields can expose static graph references without cloning definitions
(review_interface:task) {
    entry: (validate_request),
    exit: (finish),
    advance_edge: [advance],
};
(interface_caller:agent)-[:next]->(reference_values.nodes[0]);
(reference_values:vars {evaluate: "lazy"}) {
    validation_output: review_interface.entry.output,
    advance_props: [review_interface.advance_edge].props,
    nodes: [|review_interface.entry, review_interface.exit|],
};

# edge lists, source/target access, and explicit cycles
(review_request:task) {
    output: {ready: true, payload: "visit details"},
}
    -[
        advance:next {when: source.output.ready, max_attempts: settings.max_attempts},
        supply:feeds {value: source.output.payload},
    ]->(validate_request:tool) {
        output: {valid: chance(0.9)},
    }
        ~[
            retry:next {when: !source.output.valid, max_attempts: [review_interface.advance_edge].props.max_attempts},
            feedback:feeds {value: source.output},
        ]~>(review_request);

# cycle edges have their own kind, identity and configuration
# max_attempts is illustrative, the language does not execute retries
(poll_visit:tool)
    ~[poll_again:repeat {max_attempts: settings.max_attempts}]~>(poll_visit);

# endpoint access works with anonymous nodes too
(:tool {name: "check_visit"}) {
    output: {ready: chance(0.8)},
}
    =[:exclusive]=>[
        -[:next {when: source.output.ready}]->(finish),
        -[:next {when: !source.output.ready}]->(pending_visit:task),
    ];

# path-pattern references select existing nodes or edges
# ?<...> locates an existing definition, @ marks the one node or edge returned
# no declarations occur inside a pattern, kind annotations constrain matches
# require one distinct target, zero/multiple targets are errors
# multiple matching paths to the same target are acceptable
# these refer to definitions, not execution occurrences or collected paths
# parser must distinguish closing > from arrows and comparison operators
(pattern_references:vars {evaluate: "lazy"}) {
    tool_node: ?<(collect)-[:next]->(@:tool)>,
    next_edge: ?<(collect)-[@:next]->(lookup)>,
};
# broader collection filtering remains deferred, no match/where clauses

# deferred: declarations and graph fragments embedded in field values
# properties cannot contain declarations, bodies have no bare graph statements

# illustrative companion definitions, domain schemas belong to future providers
(routing_correct:scorer {lang: "python"}) {
    output: {department: context.output.department},
    expected: {department: "appointments"},
    code: {score: self.output.department == self.expected.department ? 1 : 0},
};

# candidate field-based association, no implicit graph containment
(intake_cases:dataset) {
    cases: [|(appointment_case)|],
};

(appointment_case:case) {
    input: {message: "I need an appointment", patient_id: "p-123"},
    expected: {department: "appointments"},
};

# candidate only, intake still needs a corresponding department output contract
(routing_check:experiment) {
    dataset: (intake_cases),
    task: (intake),
    scorers: [|(routing_correct)|],
};

# compilation validates language structure and references
# provider schemas, kind extension, and execution are future work
# graph names reserve self, source, target, context, true, false, and null

# distinct literal comparisons share the same sampled department binding
(route)
    =[:exclusive]=>[
        -[:next {when: source.output.department == "billing"}]->(billing:task),
        -[:next {when: source.output.department == "appointments"}]->(appointments:task),
        -[:next {when: source.output.department == "records"}]->(records_request:task),
    ];

# containment, prerequisites, and plain adjacency have distinct contracts
(intake)-[:contains]->(collect);
(route)-[:requires]->(lookup);
(routing_correct)-[:link]->(routing_check);

# each junction kind specifies a different arrival operation
>[:merge [appointment], [patient_details]]>>(arrival_log:task);
>[:first {correlate: settings.request_id} [coverage], [records]]>>(first_check:task);
>[:quorum {count: 2, correlate: settings.request_id} [to_identity], [to_insurance], [to_schedule]]>>(enough_checks:task);


# span and tool_span are supplied by the provider source in compilation.rs
# local kinds inherit strict properties and open content fields
+(patient_lookup::tool_span {
    props: {
        resource: {type: "string", default: "patients"},
    },
    fields: {
        patient_id: {required: true},
    },
});

+-[patient_data::feeds {
    props: {
        label: {type: "string", default: "patient identity"},
    },
}]-;

+=[patient_checks_kind::parallel {
    props: {
        label: {type: "string"},
    },
}]=;

+>[patient_join::accumulate {
    props: {
        label: {type: "string"},
    },
}]>>;

# an incoming field is a requirement, its destination reference does not read it
(patient_request:span {name: "Patient request"}) {
    patient_id: context.patient_id,
    patient: {id: self.patient_id},
    description: "Patient ${self.patient_id}",
}
    -[patient_delivery:patient_data {
        value: source.patient.id,
        into: target.patient_id,
    }]->(patient_step:patient_lookup {name: "Look up patient"}) {
        patient_id: <-,
        output: {id: self.patient_id},
        extra_content: "open fields remain available",
    };

# specializations retain the behavior of their base primitive
(patient_step)
    =[declared_checks:patient_checks_kind {label: "checks"}]=>[
        -[declared_a:next]->(finish),
        -[declared_b:next]->(lookup),
    ]
        >[:patient_join {label: "combined", correlate: settings.request_id}
            [declared_a],
            [declared_b],
        ]>>(typed_result:span {name: "Collected results"});

# undirected endpoints keep their authored positions when matched in reverse
+-[friendship::link {direction: "undirected", props: {weight: {type: "number"}}}]-;
(graph_a:node) {affinity: 4, records: [|1, 2, 3|]};
(graph_b:node) {affinity: 2};
(graph_c:node);
(graph_a)-[undirected_ab:friendship {weight: min(left.affinity, right.affinity)}]-(graph_b)
    -[undirected_bc:friendship]-(graph_c);
(graph_c)~[return_to_a:next]~>(graph_a);
(undirected_refs:vars) {
    connection: ?<(graph_b)-[@:friendship]-(graph_a)>,
    authored_left: [undirected_ab].left,
    authored_right: [undirected_ab].right,
};

# overlapping selections do not create containment or execution
(undirected_network:network {
    nodes: [|(graph_a), (graph_b), (graph_c)|],
    edges: [|[undirected_ab], [undirected_bc]|],
    acyclic: "underlying",
    connected: "weak",
    self_loops: false,
    max_parallel: 1,
    degree: {max: 2},
});
(materialized_network:network {
    nodes: [|(graph_a), (graph_b), (graph_c)|],
    edges: [|[undirected_ab], [undirected_bc], [return_to_a]|],
    validate: "materialized",
    connected: "strong",
});

# one relation identity joins two inputs to one output
(conversion:relation {participants: {min: 3, max: 3}, inputs: {min: 2}, outputs: {min: 1}});
(conversion)-[:incidence {role: "input"}]-(graph_a);
(graph_b)-[:incidence {role: "input"}]-(conversion);
(conversion)-[:incidence {role: "output"}]-(graph_c);

# consumers sample weighted branches using their seeded evaluation context
(graph_a)
    =[:weighted {count: 1}]=>[
        -[:next {weight: 3}]->(graph_b),
        -[:next {weight: 1}]->(graph_c),
    ];

# each occurrence belongs to one group and reduce waits for explicit closure
(graph_a)
    =[record_batch:each {items: source.records, concurrency: 2}]=>[
        -[processed:next]->(processor:node) {
            value: context.item,
            index: context.index,
        },
    ]
        >[:reduce {
            observe: "result",
            initial: 0,
            combine: context.accumulator + context.arrival.value,
            order: "source",
            on_failure: "fail",
            on_cancel: "fail",
        } [processed]]>>(total:node) {value: <-};
