("answer-quality":scorer {lang: "python", file: "answer-quality"}) {
    score: clamp(normal(0.85, 0.05), 0, 1),
    steps: [|{when: contains(context.output, "I don't know"), score: 0}|],
};

("answer-coverage":scorer {lang: "python", file: "answer-quality"}) {
    score: contains(context.output, context.expected) ? 1 : 0,
    steps: [|{when: context.output == null, score: 0}|],
};

(helpfulness:scorer) {
    judge: {
        model: "gpt-4o-mini",
        prompt: "Rate how helpful the response ${context.output} is to ${context.input}.",
        options: {helpful: 1.0, partially_helpful: 0.5, unhelpful: 0.0},
    },
};
