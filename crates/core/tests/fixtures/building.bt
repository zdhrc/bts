# packed code scorers and a judge exercise both generated definitions

scorer "answer-quality" {
    lang = "python"
    file = "answer-quality"

    code {
        score = clamp(normal(0.85, 0.05), 0, 1)

        when {
            cond = contains(output, "I don't know")
            score = 0
        }
    }
}

scorer "answer-coverage" {
    lang = "python"
    file = "answer-quality"

    code {
        score = contains(output, expected) ? 1 : 0

        when {
            cond = output == null
            score = 0
        }
    }
}

scorer "helpfulness" {
    judge {
        model = "gpt-4o-mini"
        prompt = "Rate how helpful the response ${output} is to ${input}."
        options = { helpful = 1.0, partially_helpful = 0.5, unhelpful = 0.0 }
    }
}
