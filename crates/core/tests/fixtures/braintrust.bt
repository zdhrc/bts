# provider definitions are supplied by the host
+(patient_lookup:node {resource: {type: "string", default: "patients"}}) {
    patient_id: {type: "string", required: true},
}
    -[:extends]->(tool);

(intake:agent {name: "Hospital intake", description: "Identify a patient and route their request"}) {
    input: {patient_id: "p-123"},
    output: format_reply.output,
    expected: {role: "assistant", content: "I can help with that"},
};

# both consumers start here and resolve the same authored field dependencies
(intake)-[:next]->(request:span {name: "intake"}) {
    input: intake.input,
    output: {patient_id: self.input.patient_id},
    tags: [|"intake"|],
    metadata: {request_id: "req-123"},
};

# calls goes down a level, and the steps that follow along next stay on it
(request)-[:calls, :feeds {value: source.output.patient_id, into: target.patient_id}]->(lookup:patient_lookup) {
    patient_id: <-,
    input: {patient_id: self.patient_id},
    output: {found: true},
    duration: 0.2,
};

(lookup)-[:next]->(route:task) {output: "appointments"}
    -[:calls]->(reply:llm {name: "Chat Completion"}) {
        input: [|{role: "user", content: "Book an appointment"}|],
        output: {role: "assistant", content: "I can help with that"},
        metadata: {model: "intake-model"},
        metrics: {prompt_tokens: 12, completion_tokens: 8, tokens: 20},
    };

# a next edge from the nested task returns to its level
(route)-[:next]->(format_reply:function) {output: reply.output}
    -[:next]->(grade:scorer {file: "intake_checks"}) {
        score: context.output.patient_id == context.input.patient_id ? 1 : 0,
        reason: "Preserved the patient identifier",
    };

(failed:tool) {error: {message: "Patient lookup timed out"}, expected: {found: true}};
(:task) {input: "anonymous spans are allowed"};
