# provider definitions are supplied by the host
+(patient_lookup::tool {
    props: {resource: {type: "string", default: "patients"}},
    fields: {patient_id: {type: "string", required: true}},
});

(request:span {name: "intake"}) {
    input: {patient_id: "p-123"},
    output: {patient_id: self.input.patient_id},
    tags: [|"intake"|],
    metadata: {request_id: "req-123"},
};

(request)-[:feeds {value: source.output.patient_id, into: target.patient_id}]->(lookup:patient_lookup) {
    patient_id: <-,
    input: {patient_id: self.patient_id},
    output: {found: true},
    duration: 0.2,
    extra_content: "open fields remain available",
};

(lookup)-[:next]->(route:task) {output: "appointments"}
    -[:next]->(reply:llm {name: "Chat Completion"}) {
        input: [|{role: "user", content: "Book an appointment"}|],
        output: {role: "assistant", content: "I can help with that"},
        metadata: {model: "intake-model"},
        metrics: {prompt_tokens: 12, completion_tokens: 8, tokens: 20},
    }
    -[:next]->(format_reply:function) {output: reply.output}
    -[:next]->(grade:scorer) {score: 1, reason: "Routed to appointments", scores: {routing: 1}};

(failed:tool) {error: {message: "Patient lookup timed out"}, expected: {found: true}};
(:task) {input: "anonymous spans are allowed"};
