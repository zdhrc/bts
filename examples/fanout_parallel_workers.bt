# fanout over parallel workers -- variance axes: fan width and worker
# heterogeneity. a choice inside each worker gives it its own coherent
# authored report. generated timestamps are sequential slots, so the fanout
# is structural: workers read as siblings, not as temporally overlapping
# spans.

vars {
    system = "Summarize the incident report in one sentence."
    meta = { model = "gpt-4o-mini", provider = "openai" }
}

trace "incident-digest" {
    input = "Summarize last week's incident reports."
    output = "7 incidents, 2 sev-1s; the common cause was connection pool exhaustion."
    metadata = { batch_id = format("batch_{}", hex(8)) }
    tags = ["batch"]

    repeat "workers" {
        count = range(2, 6)

        # each stamp picks one report variant; repeat.index labels the shard
        # but never stands in for content
        task "summarize_report" {
            input = { report_id = "inc_${repeat.index}" }
            # the worker's own output follows whichever report was picked:
            # the same-named llms form a collection indexed by `chosen`
            output = { summary = choice.report.chosen == 0
                ? choice.report.llm["Chat Completion"][0].output.content
                : choice.report.llm["Chat Completion"][1].output.content }

            choice "report" {
                llm "Chat Completion" {
                    input = [
                        { role = "system", content = var.system },
                        { role = "user", content = "Sev-1: checkout errors spiked at 09:14; db connections pinned at max until the pool was resized." },
                    ]
                    output = { role = "assistant", content = "connection pool exhausted during peak traffic" }
                    metadata = var.meta
                    metrics = {
                        prompt_tokens = tokens(self.input)
                        completion_tokens = tokens(self.output)
                        tokens = self.metrics.prompt_tokens + self.metrics.completion_tokens
                        time_to_first_token = 0.33
                    }
                }

                llm "Chat Completion" {
                    input = [
                        { role = "system", content = var.system },
                        { role = "user", content = "Sev-2: 5xx rate climbed after the 14:00 deploy; clients retried aggressively and amplified the load." },
                    ]
                    output = { role = "assistant", content = "retry storm after the tuesday deploy" }
                    metadata = var.meta
                    metrics = {
                        prompt_tokens = tokens(self.input)
                        completion_tokens = tokens(self.output)
                        tokens = self.metrics.prompt_tokens + self.metrics.completion_tokens
                        time_to_first_token = 0.29
                    }
                }
            }
        }
    }

    task "reduce" {
        # a slice projects the rest of the path over every stamped worker
        input = { summaries = [...repeat.workers[:].task.summarize_report.output.summary] }
        output = "7 incidents, 2 sev-1s; the common cause was connection pool exhaustion."
    }
}
