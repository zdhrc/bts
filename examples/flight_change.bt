# the world an agent works in stands beside it, and the world provider builds it by walking
# a walk is built by the steps under it, taken in the order written, and neither it nor its steps emit a span

# the policies the agent works under, defined once, each a step of the list
(policies:list)
    -[:next]->(fee:policy {subject: "a same-day change", verb: "cost", complement: "75 USD"})
    -[:next]->(window:policy {subject: "the change window", verb: "close", complement: "two hours before departure"})
    -[:next]->(payment:policy {subject: "the fare difference", verb: "be", modal: "must", complement: "paid before the new ticket is issued"});

# how the traveler asks: each trace walks this once, and each fork chooses one part
(ask:sentence)
    -[:next]->(:part {subject: "I", person: "first"})
    =[:weighted]=>[
        -[:next {weight: 2}]->(:part {modal: "can", form: "question"}),
        -[:next {weight: 1}]->(:part {modal: "could", form: "question"}),
        -[:next {weight: 1}]->(:part {modal: "must"}),
    ]
    =[:weighted]=>[
        -[:next {weight: 1}]->(:part {verb: "change", complement: "my flight"}),
        -[:next {weight: 1}]->(:part {verb: "switch", complement: "to a later flight"}),
    ];

# the agent reads the world by name
(flight_change:agent) {input: {booking: "AB42"}, output: reply.output.content};
(flight_change)-[:next]->(request:task {name: "flight-change"}) {
    input: flight_change.input,
    output: reply.output.content,
    tags: [|"flight-change"|],
};
(request)-[:calls]->(search:tool {name: "search_flights"}) {
        input: {booking: request.input.booking},
        output: {date: "2026-11-20", departs: "17:30", fare_difference: 1240.5},
    }
    # what the agent says is a statement on its own path
    -[:next]->(found:statement {subject: "I", person: "first", verb: "find", complement: "a later flight", tense: "past"})
    # the reply relates two statements and formats what the search returned
    -[:next]->(reply:llm {name: "Chat Completion"}) {
        input: [|
            {role: "system", content: compose([|"Follow the change policies.", policies.text|])},
            {role: "user", content: ask.text},
        |],
        output: {role: "assistant", content: format("{} It leaves on {} at {}. {}",
            combine([|found.sentence, fee.sentence|], "and"),
            format_date(search.output.date, {style: "long"}),
            format_time(search.output.departs),
            payment.text)},
        metadata: {model: "gpt-4o-mini", provider: "openai"},
    };
