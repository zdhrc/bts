# one sampled decision keeps the failed charge, escalation and retry consistent
(payments:agent) {input: "Charge the June invoice for acct_9W31.", output: request.output};
(payments)-[:next]->(request:task {name: "payments-agent"}) {
    input: payments.input,
    output: charge.output,
    local: {failed: chance(0.07)},
    metadata: {run_id: uuid(), retried: self.local.failed},
    tags: [|"payments"|],
};
(request)-[:calls]->(confirm:llm {name: "Chat Completion"}) {
    input: [|
        {role: "system", content: "You are a payments agent. Confirm the invoice before charging."},
        {role: "user", content: request.input},
    |],
    output: {role: "assistant", content: "The June invoice is $1,240.00. Charging the card on file."},
    metadata: {model: "gpt-4o-mini", provider: "openai"},
    metrics: {prompt_tokens: tokens(self.input), completion_tokens: tokens(self.output)},
}
    =[:exclusive]=>[
        -[failed:next {when: request.local.failed}]->(declined:tool {name: "charge_customer"}) {
            input: {account: "acct_9W31", amount_usd: 1240},
            output: null,
            error: "card_declined: insufficient_funds",
        },
        -[healthy:next {when: !request.local.failed}]->(ready:task) {output: "Primary card ready"},
    ]
        ->(declined)-[:next]->(escalate:task {name: "escalate_to_human"}) {
            input: "Charge declined (${declined.error}). Review before retrying.",
            output: "Ticket PAY-4411 approved a retry against the backup card.",
        }
        >[:first {observe: "result"} [failed], [healthy]]>>(charge);
(charge:tool {name: "charge_customer"}) {
    input: {account: "acct_9W31", amount_usd: 1240, card: request.local.failed ? "backup" : "primary"},
    output: {status: "succeeded", charge_id: format("ch_{}", alphanum(14))},
};
