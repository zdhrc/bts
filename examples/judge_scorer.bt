# build a judge scorer that grades responses against labeled options
(helpfulness:scorer) {
    judge: {
        model: "gpt-4o-mini",
        prompt: "Rate how helpful the response is to the user's request.\n            Request: ${context.input}\n            Response: ${context.output}",
        options: {excellent: 1.0, good: 0.6, poor: 0.2},
    }
};
