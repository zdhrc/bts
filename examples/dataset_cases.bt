# cases reuse whole traces, individual spans or authored field values
("support-lookup_agent":agent {name: "support-lookup"}) {input: {question: "Where can I download my invoices?"}, output: ("support-lookup").output};

("support-lookup_agent")-[:next]->("support-lookup");
("support-lookup":task) {
    input: ("support-lookup_agent").input,
    output: ("answer-request").output
};

("support-lookup")-[:calls]->("answer-request");
("answer-request":task) {
    input: ("support-lookup").input,
    output: ("draft-answer").output.content
};

("answer-request")-[:calls]->("search-kb");
("search-kb":tool) {
    input: {query: ("support-lookup").input.question},
    output: {article: "Billing > Invoices", url: "/billing/invoices"}
};

("search-kb")-[:next]->("draft-answer");
("draft-answer":llm) {
    input: {question: ("support-lookup").input.question, article: ("search-kb").output.article},
    output: {role: "assistant", content: "Download invoices from Billing > Invoices."}
};

("support-regressions":dataset) {
    description: "Billing support examples from authored inputs and trace spans",
    cases: [|(inline), ("whole-trace"), ("field-values"), (search), (answer)|]
};

(inline:case) {
    input: {question: "Can I export my invoices?"},
    expected: "Export invoices from Billing > Invoices.",
    metadata: {topic: "invoices", source: "authored"},
    tags: [|"billing", "inline"|]
};

("whole-trace":case) {
    tags: [|"billing", "trace"|],
    source: ("support-lookup")
};

("field-values":case) {
    input: ("support-lookup").input,
    expected: ("support-lookup").output,
    tags: [|"billing", "fields"|]
};

(search:case) {
    source: ("search-kb")
};

(answer:case) {
    source: ("draft-answer")
};
