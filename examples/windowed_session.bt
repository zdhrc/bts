# a session is two traces in a row that carry one identifier: the window that opens it, then a later one
(session:conversation {turns: 2});

# a selected window carries its own question, answer and prior context
(copilot:agent) {input: null, output: request.output};
(copilot)-[:next]->(request:task {name: "copilot-window"}) {
    input: copilot.input,
    local: {position: session.turn},
    output: self.local.position == 0 ? opening.output : later.output,
    metadata: {session_id: format("sess_{}", session.id), window: self.local.position == 0 ? 0 : 3},
    tags: [|"copilot"|],
};
(request)
    =[:exclusive]=>[
        -[:calls {when: request.local.position == 0}]->(opening:task {name: "turn"}) {
            input: "Why does my worker pool deadlock on shutdown?",
            output: "Your workers block on the results channel. Drain results before joining them.",
            metadata: {window: 0},
        },
        -[:calls {when: request.local.position == 1}]->(later:task {name: "turn"}) {
            input: "Now the shutdown races with the metrics flush.",
            output: "Flush from the shutdown coordinator after the workers have joined.",
            metadata: {window: 3},
        },
    ]
        ->(opening)-[:calls]->(opening_reply:llm {name: "Chat Completion"}) {
            input: [|
                {role: "system", content: "You are a coding copilot. Prior context arrives as a summary message."},
                {role: "user", content: opening.input},
            |],
            output: {role: "assistant", content: opening.output},
            metadata: {model: "gpt-4o-mini", provider: "openai"},
        }
        ->(later)-[:calls]->(later_reply:llm {name: "Chat Completion"}) {
            input: [|
                {role: "system", content: "You are a coding copilot. Prior context arrives as a summary message."},
                {role: "system", content: "Summary of windows 0-2: the worker-pool deadlock was fixed by draining results before joining. A race in shutdown remains."},
                {role: "user", content: later.input},
            |],
            output: {role: "assistant", content: later.output},
            metadata: {model: "gpt-4o-mini", provider: "openai"},
        };
