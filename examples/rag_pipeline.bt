# retrieval, ranking and an answer share the same document evidence
# a retrieval step states how many documents it considered, whatever span kind it is
+(retrieval:trait) {considered: {type: "number", required: true}}
    -|:on|->(node);
+(doc_search:node)
    -|:extends|->(tool)
    -|:has|->(retrieval);
+(doc_rerank:node)
    -|:extends|->(task)
    -|:has|->(retrieval);

(docs_qa:agent) {input: "How do I rotate API keys?", output: answer.output.content};
(docs_qa)-|:next|->(request:task) {
    input: docs_qa.input,
    output: answer.output.content,
    metadata: {request_id: uuid()},
    tags: ["rag"],
};
(request)-|:calls|->(search:doc_search {name: "search_docs"}) {
    duration: lognormal(0.4, 0.3),
    considered: 8,
    input: {query: request.input, top_k: self.considered},
    output: {doc_ids: ["doc_112", "doc_089", "doc_331"], scores: [0.91, 0.63, 0.44]},
}
    -|:next|->(rerank:doc_rerank) {
        duration: 0.12,
        considered: len(search.output.doc_ids),
        input: {candidates: self.considered},
        output: {kept: search.output.doc_ids[:2]},
    }
        -|:next|->(answer:llm {name: "Chat Completion"}) {
            local: {gen_time: lognormal(2.4, 0.4)},
            duration: self.local.gen_time,
            input: {
                system: "Answer using only the provided documents. Cite doc ids.",
                question: request.input,
                document_ids: rerank.output.kept,
                documents: [
                    {id: "doc_112", content: "Rotate API keys under Settings > API. Old keys remain valid for 24 hours."},
                    {id: "doc_089", content: "Service accounts have individually scoped API keys."},
                ],
            },
            output: {role: "assistant", content: "Rotate keys under Settings > API. The old key stays valid for 24 hours. [doc_112]"},
            metadata: {model: "gpt-4o-mini", provider: "openai"},
            metrics: {time_to_first_token: self.local.gen_time * range(0.1, 0.25)},
        };
