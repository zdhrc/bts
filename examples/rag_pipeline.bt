# rag pipeline -- variance axes: how many documents come back, retrieval
# quality (hit vs miss), and extra stages (query rewrite, guardrails).

vars {
    system = "Answer using only the provided documents. Cite doc ids."
    meta = { model = "gpt-4o-mini", provider = "openai" }
}

trace "docs-qa" {
    input = "How do I rotate API keys?"
    # the trace answers with whatever the generate span actually said
    output = llm["Chat Completion"].output.content
    metadata = { request_id = uuid() }
    tags = ["rag"]

    tool "search_docs" {
        input = { query = "rotate API keys", top_k = 8 }
        output = {
            doc_ids = ["doc_112", "doc_089", "doc_331"]
            scores = [0.91, 0.63, 0.44]
        }
    }

    task "rerank" {
        # downstream stages read the retriever's actual output; kept is a
        # slice of the candidate ids
        input = { candidates = len(tool.search_docs.output.doc_ids) }
        output = { kept = tool.search_docs.output.doc_ids[:2] }
    }

    llm "Chat Completion" {
        input = [
            { role = "system", content = var.system },
            {
                role = "user"
                content = <<-CTX
                    [${task.rerank.output.kept[0]}] API keys: rotation and expiry
                    [${task.rerank.output.kept[1]}] Service accounts and scopes

                    Question: ${trace.input}
                CTX
            },
        ]
        output = { role = "assistant", content = "Rotate keys under Settings > API; the old key stays valid for 24 hours. [doc_112]" }
        metadata = var.meta
        metrics = {
            prompt_tokens = tokens(self.input)
            completion_tokens = tokens(self.output)
            tokens = self.metrics.prompt_tokens + self.metrics.completion_tokens
            time_to_first_token = 0.47
        }
    }
}
