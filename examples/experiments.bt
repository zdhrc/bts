# compare two agents against the same five recovery cases
(basic_agent:agent) {input: {message: "I forgot my password.", email_verified: true, account_locked: false, mfa_available: true}, output: ("basic-flow").output};
(basic_agent)-[:next]->("basic-flow");
(recovery_agent:agent) {input: {message: "I forgot my password.", email_verified: true, account_locked: false, mfa_available: true}, output: ("recovery-flow").output};
(recovery_agent)-[:next]->("recovery-flow");

("basic-flow":task) {
    input: basic_agent.input,
    output: {
        action: self.input.email_verified ? "send_reset" : "verify_email",
        reply: ("draft-reply").output.content,
    },
    metadata: {version: "basic", channel: "chat"}
};

("basic-flow")-[:calls]->("lookup-account");
("lookup-account":tool) {
    duration: range (0.05, 0.15),
    input: {request: ("basic-flow").input.message},
    output: {
        email_verified: ("basic-flow").input.email_verified,
        account_locked: ("basic-flow").input.account_locked,
        mfa_available: ("basic-flow").input.mfa_available,
    }
};

("lookup-account")-[:next]->("draft-reply");
("draft-reply":llm) {
    duration: range (0.4, 0.8),
    input: {request: ("basic-flow").input.message, account: ("lookup-account").output},
    output: {
        role: "assistant",
        content: ("lookup-account").output.email_verified ? "I've sent a password reset link to your verified email. The link expires in 15 minutes." : "Please verify your email address before we can help you recover the account.",
    },
    metadata: {model: "gpt-4o-mini", provider: "openai"}
};

("recovery-flow":task) {
    input: recovery_agent.input,
    output: {
        action: ! self.input.email_verified ? "verify_email" : self.input.account_locked ? "escalate_locked" : ! self.input.mfa_available ? "recover_mfa" : "send_reset",
        reply: ("recovery-flow_draft-reply").output.content,
    },
    metadata: {version: "improved", channel: "chat"}
};

("recovery-flow")-[:calls]->("recovery-flow_lookup-account");
("recovery-flow_lookup-account":tool {name: "lookup-account"}) {
    duration: range (0.05, 0.15),
    input: {request: ("recovery-flow").input.message},
    output: {
        email_verified: ("recovery-flow").input.email_verified,
        account_locked: ("recovery-flow").input.account_locked,
        mfa_available: ("recovery-flow").input.mfa_available,
    }
};

("recovery-flow_lookup-account")-[:next]->("recovery-flow_draft-reply");
("recovery-flow_draft-reply":llm {name: "draft-reply"}) {
    duration: range (0.4, 0.8),
    input: {request: ("recovery-flow").input.message, account: ("recovery-flow_lookup-account").output},
    output: {
        role: "assistant",
        content: ! ("recovery-flow_lookup-account").output.email_verified ? "Please verify your email address before we can help you recover the account." : ("recovery-flow_lookup-account").output.account_locked ? "Your account is locked. I've escalated this to our account security team; they'll contact your verified email." : ! ("recovery-flow_lookup-account").output.mfa_available ? "A password reset won't restore your MFA access. Use a backup code, or start identity verification with our recovery team." : "I've sent a password reset link to your verified email. The link expires in 15 minutes.",
    },
    metadata: {model: "gpt-4o-mini", provider: "openai"}
};

("account-recovery-regressions":dataset) {
    description: "Ordinary resets, unverified email, locked accounts, and lost MFA devices",
    cases: [|
        ("forgot-password"),
        ("expired-reset-link"),
        ("unverified-email"),
        ("locked-account"),
        ("lost-mfa-device"),
    |]
};

("forgot-password":case) {
    input: {
        message: "I forgot my password. Can you help me sign in?",
        email_verified: true,
        account_locked: false,
        mfa_available: true,
    },
    expected: {action: "send_reset", reply_phrase: "password reset link"},
    metadata: {scenario: "password_reset", customer_tier: "free"},
    tags: [|"routine"|]
};

("expired-reset-link":case) {
    input: {
        message: "The reset link from yesterday expired. Can you send another?",
        email_verified: true,
        account_locked: false,
        mfa_available: true,
    },
    expected: {action: "send_reset", reply_phrase: "password reset link"},
    metadata: {scenario: "expired_link", customer_tier: "pro"},
    tags: [|"routine"|]
};

("unverified-email":case) {
    input: {
        message: "I never verified my email and now I can't remember my password.",
        email_verified: false,
        account_locked: false,
        mfa_available: true,
    },
    expected: {action: "verify_email", reply_phrase: "verify your email"},
    metadata: {scenario: "unverified_email", customer_tier: "free"},
    tags: [|"verification"|]
};

("locked-account":case) {
    input: {
        message: "Too many sign-in attempts locked me out. I need access before our customer call.",
        email_verified: true,
        account_locked: true,
        mfa_available: true,
    },
    expected: {action: "escalate_locked", reply_phrase: "account security team"},
    metadata: {scenario: "locked_account", customer_tier: "enterprise"},
    tags: [|"edge-case", "urgent"|]
};

("lost-mfa-device":case) {
    input: {
        message: "I replaced my phone and lost my authenticator. Resetting my password didn't help.",
        email_verified: true,
        account_locked: false,
        mfa_available: false,
    },
    expected: {action: "recover_mfa", reply_phrase: "backup code"},
    metadata: {scenario: "lost_mfa", customer_tier: "pro"},
    tags: [|"edge-case", "mfa"|]
};

("recovery-action-correctness":scorer {file: "recovery"}) {
    score: context.output.action == context.expected.action ? 1 : 0
};

("recovery-verification-gate":scorer {file: "recovery"}) {
    score: context.output.action != "send_reset" || context.input.email_verified ? 1 : 0
};

("recovery-next-step-clarity":scorer {file: "recovery"}) {
    score: contains (context.output.reply, context.expected.reply_phrase) ? 1 : 0
};

("recovery-baseline":experiment) {
    description: "Basic email reset flow; misses locked accounts and lost MFA devices",
    dataset: ("account-recovery-regressions"),
    task: ("basic-flow"),
    scorers: [|("recovery-action-correctness"), ("recovery-verification-gate"), ("recovery-next-step-clarity")|]
};

("recovery-improved":experiment) {
    description: "Recovery flow with locked-account escalation and MFA recovery guidance",
    dataset: ("account-recovery-regressions"),
    task: ("recovery-flow"),
    scorers: [|("recovery-action-correctness"), ("recovery-verification-gate"), ("recovery-next-step-clarity")|],
    baseline: ("recovery-baseline")
};
